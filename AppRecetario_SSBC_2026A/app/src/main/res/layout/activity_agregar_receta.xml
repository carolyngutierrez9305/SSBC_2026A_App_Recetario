<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <EditText
        android:id="@+id/nombre_receta_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de la receta" />

    <EditText
        android:id="@+id/ingredientes_receta_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredientes"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/procedimiento_receta_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Procedimiento"
        android:layout_marginTop="16dp" />

    <ImageView
        android:id="@+id/imagen_seleccionar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:scaleType="centerCrop"
        android:layout_marginTop="16dp"
        android:contentDescription="Seleccionar imagen" />

    <Button
        android:id="@+id/btn_guardar_receta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guardar Receta"
        android:backgroundTint="@color/amarillo"
        android:layout_marginTop="24dp" />
</LinearLayout>